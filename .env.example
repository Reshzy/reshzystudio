# Public site URL used for canonical links, sitemap, robots, and Open Graph.
# Set this to your production domain on Vercel (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://reshzystudio.com

# Optional webhook endpoint for contact form delivery.
# Accepts a JSON POST with { name, email, message, source, submittedAt }.
# Compatible with Formspree, Make, Zapier, and similar receivers.
# Required in production for the contact form to succeed.
# CONTACT_WEBHOOK_URL=
